# CF Pages applies EVERY matching rule and APPENDS duplicate headers, it does
# not pick the most specific one. A Cache-Control on /* therefore concatenates
# onto the asset rules below and produces:
#   public, max-age=31536000, immutable, public, max-age=0, must-revalidate
# which defeats the immutable caching it was meant to complement. So /* carries
# security headers only; HTML keeps the Pages default (no-cache), which is what
# we wanted from it anyway.

# Content-hashed build output — safe to pin for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Work imagery is stable but not content-hashed — a week, revalidated.
/work/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
