# Content-hashed build output is safe to pin for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Work imagery is stable but not hashed — a week, revalidated.
/work/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML must NEVER be immutable. A stale document cached under an asset URL
# is unrecoverable without a hard purge (see the CF Pages poisoning note).
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
